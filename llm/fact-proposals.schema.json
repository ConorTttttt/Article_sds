{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM regulatory fact-proposal packet; no legal decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proposals"
  ],
  "properties": {
    "schemaVersion": {
      "const": "llm-extraction-v1"
    },
    "proposals": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "certainty",
          "suggestedValue",
          "sourceRef",
          "evidenceExcerpt"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 3
          },
          "certainty": {
            "enum": [
              "asserted",
              "unknown"
            ]
          },
          "suggestedValue": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "evidenceExcerpt": {
            "type": "string",
            "minLength": 5
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "Parser can propose sourced facts for review only. Outcomes, Candidate List membership, Article 3(3) judgement, and exemptions cannot be asserted by the LLM."
}
